{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poyo's Face Util Sender",
  "version": "0.4.0",
  "identifier": "net.maaaaa.face-util.sender",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Poyo's Face Util Sender",
        "width": 520,
        "height": 760,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
